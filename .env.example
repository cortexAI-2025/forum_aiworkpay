PORT=3000
DATA_DIR=./data
ADMIN_TOKEN=replace-with-a-long-random-secret
# Set to true behind a reverse proxy (Railway): uses the last X-Forwarded-For hop for rate limits and enables HSTS
TRUST_PROXY=false
# Required on Vercel: dedicated PostgreSQL database, server-side only.
# Use the provider's TLS connection URL and a role owning the private forum schema.
DATABASE_URL=
